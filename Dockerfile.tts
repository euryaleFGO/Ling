FROM python:3.12-slim AS base

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libsndfile1 ffmpeg curl \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/tts_server/requirements.txt /app/requirements.txt 2>/dev/null || true
RUN pip install --no-cache-dir flask flask-cors requests numpy \
    torchaudio onnxruntime modelscope hyperpyyaml einops omegaconf \
    tqdm scipy librosa soundfile 2>/dev/null || \
    pip install --no-cache-dir flask flask-cors requests numpy

COPY deploy/tts_server/ /app/
COPY src/backend/tts/ /app/tts_lib/

ENV TTS_HOST=0.0.0.0
ENV TTS_PORT=5001
EXPOSE 5001

CMD ["python", "service.py"]
