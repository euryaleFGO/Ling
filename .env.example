# ============================================================
# 玲 (Liying) - 智能虚拟助手系统
# 环境变量配置模板
# ============================================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据实际情况修改配置值
# 3. 路径使用双反斜杠（\\）或正斜杠（/）
# ============================================================

# ============================================================
# LLM API 配置（必需）
# ============================================================
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4
LIYING_DELETE_CONFIRM_KEY=your_confirm_key

# ============================================================
# 数据库（MongoDB）
# ============================================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=liying_db
# MONGODB_TIMEOUT_MS=5000

# Windows 下自动启动 MongoDB（可选）
# MONGOD_EXE=C:\\MongoDB\\bin\\mongod.exe
# MONGOD_CFG=C:\\MongoDB\\mongod.cfg

# ============================================================
# WebSocket 消息服务（Python ↔ Live2D）
# ============================================================
LIYING_WS_HOST=localhost
LIYING_WS_PORT=8765

# ============================================================
# TTS 配置
# ============================================================
# 远程 TTS 服务地址（如果使用远程 TTS）
REMOTE_TTS_URL=http://localhost:5001
LIYING_TTS_REMOTE_URL=http://127.0.0.1:18888
LIYING_TTS_SPK_ID=玲

# TTS 服务器配置（用于 deploy/tts_server）
# COSYVOICE_MODEL_PATH=/path/to/CosyVoice2-0.5B
# COSYVOICE_REF_AUDIO=/path/to/reference_audio.wav
# COSYVOICE_USE_TRT=auto
# TTS_SERVICE_PORT=5001
# RHUBARB_PATH=/path/to/rhubarb

# TTS 客户端配置
# TTS_MODE=local
# TTS_CLIENT_ID=default

# ============================================================
# 模型与数据目录（可选，默认使用项目目录）
# ============================================================
# LIYING_MODELS_DIR=/path/to/models
# LIYING_ASR_MODEL_DIR=/path/to/models/ASR/paraformer-zh-streaming
# LIYING_ASR_VAD_DIR=/path/to/models/ASR/fsmn-vad
# LIYING_TTS_MODEL_DIR=/path/to/models/TTS/CosyVoice2-0.5B
# LIYING_CHROMA_DIR=/path/to/data/chroma_data

# ============================================================
# 模型缓存目录（第三方库）
# ============================================================
# HuggingFace 模型缓存（SER 语音情绪识别）
# 推荐设置为项目目录下，避免下载到 C 盘
# HF_HOME=/path/to/project/.hf_cache

# ModelScope 模型缓存（PUNC 标点恢复、SV 说话人验证）
# MODELSCOPE_CACHE=/path/to/project/.modelscope_cache

# Matcha-TTS 模型缓存（如果使用）
# MATCHA_HOME=/path/to/project/.matcha_cache

# ============================================================
# 企业微信机器人配置
# ============================================================
# Webhook 短连接版本（需要公网 IP，旧版）
# WEWORK_CORP_ID=your_corp_id
# WEWORK_CORP_SECRET=your_corp_secret
# WEWORK_AGENT_ID=your_agent_id
# WEWORK_HOST=0.0.0.0
# WEWORK_PORT=8080
# WEWORK_WEBHOOK_KEY=your_webhook_key

# WebSocket 长连接版本（推荐，无需公网 IP）
# WEWORK_BOT_ID=your_bot_id
# WEWORK_SECRET=your_secret
# WEWORK_WS_URL=wss://openws.work.weixin.qq.com

# ============================================================
# 其他配置
# ============================================================
LIYING_USER_ID=default_user

# DeepSeek API（如果使用）
# DEEPSEEK_API_KEY=your_deepseek_api_key
# BASE_URL=https://api.deepseek.com
# MODEL=deepseek-chat

# 分布式训练配置（一般不需要修改）
# WORLD_SIZE=1
# LOCAL_RANK=0
# RANK=0
# LOCAL_WORLD_SIZE=1

# ============================================================
# 环境变量说明
# ============================================================
# 
# 核心配置（必需）：
# - OPENAI_API_BASE: LLM API 地址
# - OPENAI_API_KEY: LLM API 密钥
# - OPENAI_MODEL: 使用的模型名称
# 
# 数据库配置：
# - MONGODB_URI: MongoDB 连接地址
# - MONGODB_DB: 数据库名称
# 
# TTS 配置：
# - LIYING_TTS_REMOTE_URL: 远程 TTS 服务地址（不设置则使用本地 TTS）
# - LIYING_TTS_SPK_ID: 说话人 ID
# 
# 模型缓存：
# - HF_HOME: HuggingFace 模型缓存目录（强烈推荐设置）
# - MODELSCOPE_CACHE: ModelScope 模型缓存目录（可选）
# 
# 路径规范：
# - Windows: 使用双反斜杠 C:\\path\\to\\file 或正斜杠 C:/path/to/file
# - Linux/Mac: 使用正斜杠 /path/to/file
# - 支持相对路径和绝对路径
# 
# ============================================================
