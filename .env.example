# ============================================================
# 玲 (Liying) - 智能虚拟助手系统
# 环境变量配置模板
# ============================================================
# 使用说明：
# 1. 复制此文件为 .env
# 2. 根据实际情况修改配置值
# 3. 路径使用双反斜杠（\\）或正斜杠（/）
#
# 注意：大部分运行时配置已迁移到 config/settings.json（通过 ConfigManager 管理）。
# 本文件仅保留部署相关和敏感信息的环境变量。
#
# 已迁移到 config/settings.json 的配置：
# - LLM API 配置（api_key, base_url, model 等） -> llm 节
# - MongoDB 连接配置（uri, db） -> mongodb 节
# - WebSocket 消息服务（host, port） -> websocket 节
# - TTS 远程服务地址、说话人 ID -> tts.remote_url, tts.spk_id
# - ASR 远程服务地址 -> asr.remote_url
# ============================================================

# ============================================================
# LLM API 密钥（环境变量回退，优先级低于 settings.json llm 节）
# ============================================================
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=your_api_key_here
# OPENAI_MODEL=gpt-4

LIYING_DELETE_CONFIRM_KEY=your_confirm_key

# ============================================================
# Windows 下自动启动 MongoDB（可选）
# ============================================================
# MONGOD_EXE=C:\\MongoDB\\bin\\mongod.exe
# MONGOD_CFG=C:\\MongoDB\\mongod.cfg

# ============================================================
# 企业微信机器人配置
# ============================================================
# Webhook 短连接版本（需要公网 IP，旧版）
# WEWORK_CORP_ID=your_corp_id
# WEWORK_CORP_SECRET=your_corp_secret
# WEWORK_AGENT_ID=your_agent_id
# WEWORK_HOST=127.0.0.1
# WEWORK_PORT=8080
# WEWORK_WEBHOOK_KEY=your_webhook_key

# WebSocket 长连接版本（推荐，无需公网 IP）
# WEWORK_BOT_ID=your_bot_id
# WEWORK_SECRET=your_secret
# WEWORK_WS_URL=wss://openws.work.weixin.qq.com

# ============================================================
# 其他配置
# ============================================================
LIYING_USER_ID=default_user

# ============================================================
# 模型缓存目录（第三方库）
# ============================================================
# HF_HOME=/path/to/project/.hf_cache
# MODELSCOPE_CACHE=/path/to/project/.modelscope_cache
# MATCHA_HOME=/path/to/project/.matcha_cache

# ============================================================
# 分布式训练配置（一般不需要修改）
# ============================================================
# WORLD_SIZE=1
# LOCAL_RANK=0
# RANK=0
# LOCAL_WORLD_SIZE=1
